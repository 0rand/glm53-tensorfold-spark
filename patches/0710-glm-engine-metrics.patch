diff --git a/src/tensorfold/families/glm5_next/cuda/cachemetrics.py b/src/tensorfold/families/glm5_next/cuda/cachemetrics.py
new file mode 100644
index 000000000..ff880c2f8
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/cachemetrics.py
@@ -0,0 +1,196 @@
+"""CPU-published cache and scheduler telemetry for the GLM CUDA engine.
+
+The HTTP side only reads :meth:`CacheMetrics.snapshot`.  Mutable scheduler, pool,
+and session-store state is sampled by its owning engine thread at lifecycle
+boundaries, so a scrape never needs CUDA, a collective, or a cache walk.
+"""
+from __future__ import annotations
+
+import threading
+from contextlib import nullcontext
+from typing import Any
+
+
+_RESTORE_SOURCES = ("none", "slot", "ram", "disk")
+
+
+class CacheMetrics:
+    """A small immutable-at-publication view of GLM cache state.
+
+    ``publish_batch`` and ``publish_lone`` run only at engine/scheduler
+    boundaries.  They inspect scalar bookkeeping, never token lists or device
+    state.  ``snapshot`` returns fresh dictionaries so callers cannot mutate
+    the published view seen by another HTTP request.
+    """
+
+    def __init__(self, engine) -> None:
+        self.engine = engine
+        # Attached before CacheMetrics is made; HTTP reads can use only the
+        # DiskTier's own lock-protected, no-I/O published view.
+        self._store = getattr(engine, "store", None)
+        self._lock = threading.Lock()
+        self._restores = {name: {"requests": 0, "tokens": 0} for name in _RESTORE_SOURCES}
+        self._snapshot: dict[str, Any] = {}
+        self._lone = {"phase": None, "prefill_done": 0, "generation": 0}
+        self.publish_lone()
+
+    def record_restore(self, source: str, tokens: int) -> None:
+        """Record the outcome actually used by a request, not a lookup attempt."""
+        if source not in self._restores:
+            raise ValueError(f"unknown cache restore source {source!r}")
+        with self._lock:
+            item = self._restores[source]
+            item["requests"] += 1
+            item["tokens"] += max(0, int(tokens))
+
+    def set_lone(self, phase: str | None, *, prefill_done: int | None = None,
+                 generation: int | None = None) -> None:
+        """Publish lone-engine progress without reading its mutable caches on a scrape."""
+        with self._lock:
+            self._lone["phase"] = phase
+            if prefill_done is not None:
+                self._lone["prefill_done"] = max(0, int(prefill_done))
+            if generation is not None:
+                self._lone["generation"] = max(0, int(generation))
+        self.publish_lone()
+    def publish_waiting(self, waiting: int) -> None:
+        """Update only the queue gauge from the HTTP-side queue lock."""
+        with self._lock:
+            out = dict(self._snapshot)
+            out["requests_waiting"] = max(0, int(waiting))
+            self._snapshot = out
+
+
+    @staticmethod
+    def _pool_view(pool) -> dict[str, Any]:
+        if pool is None:
+            return {}
+        alloc = getattr(pool, "alloc", None)
+        page = getattr(pool, "page", None)
+        npages = getattr(pool, "npages", None)
+        if alloc is None or page is None or npages is None or not hasattr(alloc, "n_free"):
+            return {}
+        page, npages, free_pages = int(page), int(npages), int(alloc.n_free)
+        used_pages = npages - free_pages
+        reserved_pages = int(pool.outstanding()) if hasattr(pool, "outstanding") else 0
+        available_pages = int(pool.available()) if hasattr(pool, "available") else free_pages - reserved_pages
+        out = {
+            "pool_tokens": npages * page,
+            "pool_free_tokens": free_pages * page,
+            "pool_used_tokens": used_pages * page,
+            "pool_reserved_tokens": reserved_pages * page,
+            "pool_available_tokens": available_pages * page,
+        }
+        out["kv_pool_usage_ratio"] = used_pages / npages if npages else 0.0
+        return out
+
+    @staticmethod
+    def _store_view(store) -> dict[str, Any]:
+        if store is None:
+            return {}
+        index = getattr(store, "index", None)
+        if index is None:
+            return {}
+        entries = getattr(index, "entries", None)
+        if entries is None or not hasattr(index, "used") or not hasattr(index, "budget"):
+            return {}
+        return {
+            "kept_prompts": len(entries),
+            "kept_bytes": int(index.used),
+            "session_budget_bytes": int(index.budget),
+            "session_used_bytes": int(index.used),
+        }
+
+    @staticmethod
+    def _disk_view(store) -> dict[str, Any] | None:
+        disk = getattr(store, "disk", None) if store is not None else None
+        method = getattr(disk, "telemetry_snapshot", None)
+        if not callable(method):
+            return None
+        value = method()
+        return dict(value) if isinstance(value, dict) else None
+
+    def _base(self) -> dict[str, Any]:
+        engine = self.engine
+        limit = getattr(engine, "limit", None)
+        out: dict[str, Any] = {"cache_restores": {name: dict(value) for name, value in self._restores.items()}}
+        if limit is not None:
+            out["context_length"] = int(limit)
+        out.update(self._store_view(self._store))
+        spill = self._disk_view(self._store)
+        if spill is not None:
+            out["spill"] = spill
+        return out
+
+    def publish_lone(self) -> None:
+        """Sample a lone engine at a lifecycle boundary (never from HTTP)."""
+        with self._lock:
+            phase = self._lone["phase"]
+            running = int(phase is not None)
+            streams = {"decoding": int(phase == "decoding"), "prefilling": int(phase == "prefilling"),
+                       "filling": 0, "paused": 0, "max": 1}
+            out = self._base()
+            out.update(requests_running=running, requests_waiting=0,
+                       generation_tokens_running=self._lone["generation"], streams=streams)
+            limit = out.get("context_length", 0)
+            if limit:
+                completed = self._lone["prefill_done"] if phase is not None else 0
+                out["stream_kv_usage_ratio"] = min(completed / limit, 1.0)
+            pages = getattr(getattr(getattr(self.engine, "e", None), "st", None), "pages", None)
+            pool = getattr(pages, "pool", None)
+            out.update(self._pool_view(pool))
+            if pool is not None and phase is None:
+                out["pool_kept_tokens"] = int(getattr(pages, "held", 0)) * int(getattr(pool, "page", 0))
+            self._snapshot = out
+
+    def publish_batch(self, batch) -> None:
+        """Sample scalar batch state after a scheduler ownership transition."""
+        cv = getattr(batch, "cv", None)
+        guard = cv if hasattr(cv, "__enter__") else nullcontext()
+        # Keep cv -> cache lock ordering: HTTP submit/cancel makes its queue
+        # update under cv before it publishes the scalar waiting gauge.
+        with guard:
+            seqs = tuple(getattr(batch, "seqs", ()))
+            states = tuple(getattr(batch, "states", ()))
+            queued = len(getattr(batch, "queue", ()))
+            prefilling = sum(seq is not None and getattr(seq, "stepper", None) is None for seq in seqs)
+            decoding = sum(seq is not None and getattr(seq, "stepper", None) is not None for seq in seqs)
+            generated = sum(max(int(getattr(seq, "emitted", 0)),
+                                len(getattr(getattr(seq, "stepper", None), "out", ())))
+                            for seq in seqs if seq is not None)
+            completed = [int(getattr(seq, "done", 0)) if getattr(seq, "stepper", None) is None
+                         else int(getattr(states[slot], "pos", 0)) if slot < len(states) else 0
+                         for slot, seq in enumerate(seqs) if seq is not None]
+            pool = getattr(batch, "kvp", None)
+            idle_pages = sum(int(getattr(getattr(state, "pages", None), "held", 0))
+                             for slot, state in enumerate(states)
+                             if slot >= len(seqs) or seqs[slot] is None)
+            with self._lock:
+                out = self._base()
+                out.update(requests_running=prefilling + decoding, requests_waiting=queued,
+                           generation_tokens_running=generated,
+                           streams={"decoding": decoding, "prefilling": prefilling, "filling": 0, "paused": 0,
+                                    "max": int(getattr(batch, "n", len(seqs)))})
+                out.update(self._pool_view(pool))
+                if pool is not None:
+                    out["pool_kept_tokens"] = idle_pages * int(getattr(pool, "page", 0))
+                limit = out.get("context_length", 0)
+                if limit:
+                    out["stream_kv_usage_ratio"] = min(max(completed, default=0) / limit, 1.0)
+                self._snapshot = out
+
